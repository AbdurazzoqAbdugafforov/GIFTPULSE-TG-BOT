# GiftPulse Environment Configuration Template
# Copy this file to .env and configure your values.

# Telegram Bot Credentials
BOT_TOKEN=
ADMIN_IDS=

# Database & Cache (PostgreSQL with asyncpg & Redis)
# Inside Docker: use postgres:5432 and redis:6379
# Outside Docker: use localhost:5432 and localhost:6379
DATABASE_URL=postgresql+asyncpg://giftpulse:giftpulse_Abdi2008@postgres:5432/giftpulse
REDIS_URL=redis://redis:6379/0

# TG Gifts Open Data Feeds (CC BY 4.0 - Free Public Datasets)
TG_GIFTS_BASE_URL=https://tggifts.com
TG_GIFTS_FLOORS_URL=https://tggifts.com/data/floors-daily.json
TG_GIFTS_MODELS_URL=https://tggifts.com/data/models-daily.json
TG_GIFTS_INDEX_URL=https://tggifts.com/data/index.json

# Telegram Mini App & Security (Must be https:// for Telegram WebApp)
MINI_APP_URL=https://your-domain.com
JWT_SECRET=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
SESSION_EXPIRE_HOURS=72

# Defaults & Localization
DEFAULT_LANGUAGE=uz
DEFAULT_TIMEZONE=Asia/Tashkent

# Subscription Pricing (UZS / 30 days)
PRO_PLAN_PRICE=19900
ELITE_PLAN_PRICE=49900

# Logging & Ports
LOG_LEVEL=INFO
PORT=8000

# Manual Payment Details
PAYMENT_CARD_NUMBER=8600 0000 0000 0000
PAYMENT_CARD_HOLDER=GiftPulse LLC
